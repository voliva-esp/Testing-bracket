Bootstrap: docker
From: ubuntu:26.04

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get -y update
    apt-get install -y --no-install-recommends \
        build-essential \
        g++ \
        cmake \
        make \
        git \
        ca-certificates \
        libboost-all-dev \
        openmpi-bin \
        libopenmpi-dev \
        wget \
        time \
        python3 \
        python3-pip

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    git clone --recursive https://github.com/jhpc-quantum/RIKEN-braket.git /opt/RIKEN-braket
    cd /opt/RIKEN-braket/bra
    python3 -m pip install --break-system-packages -r qcx/requirements.txt
    make

%environment
    export PATH=/opt/RIKEN-braket/bra/bin:$PATH

%runscript
    mkdir -p results

    echo "First circuit"
    /opt/RIKEN-braket/bra/bin/bra -f /opt/RIKEN-braket/bra/qcx/hadamards08.qcx
    echo "###########################"

    for name in "q3_qft_qec_20" "q3_qft_qec_25" "q3_qft_qec_30" "q3_qft_qec_35" "q3_qft_qec_40" "q3_qft_qec_45" "q3_qft_qec_50" "q3_qft_qec_55" "q3_qft_qec_60" "q3_qft_qec_65" "q3_qft_qec_70" "q3_qft_qec_75" "q3_qft_qec_80" "q3_qft_qec_85" "q3_qft_qec_90" "q3_qft_qec_95" "q3_qft_qec_100"; do
        echo "Ejecutando circuito: $name"
        python3 /opt/RIKEN-braket/bra/qcx/qasm2qcx.py "circuits/${name}.qasm" > "results/${name}.qcx"
        echo "DO MEASUREMENT" >> "results/${name}.qcx"
        time mpiexec -np 16 /opt/RIKEN-braket/bra/bin/bra -f "results/${name}.qcx"
        echo "###########################"
    done

%labels
    Author voliva-esp